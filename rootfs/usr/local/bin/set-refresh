#!/usr/bin/env bash
# Switches the virtual screen between 60 Hz and 50 Hz (for PAL games).
# Sunshine runs this when a stream starts and ends (see apps.json). It always exits 0,
# so a problem here can never stop a stream from starting.
set -uo pipefail
# shellcheck source=/usr/local/lib/pcsx2-headless/common.sh
. /usr/local/lib/pcsx2-headless/common.sh
load_runtime_env
# Sunshine discards this command's output: send messages to the container log instead.
[ -w "${EVENT_LOG:-}" ] && exec 2>>"$EVENT_LOG"

want=${1:-60}
case $want in
    60) mode=${XORG_MODE:-} ;;
    50) mode=${XORG_MODE_50:-} ;;
    *) warn "set-refresh: use 50 or 60 (got '$want')"; exit 0 ;;
esac
if [ -z "$mode" ]; then
    warn "No ${want} Hz screen mode available; keeping the current refresh rate"
    exit 0
fi

# The output gen-xorg-conf chose (AMD/Intel). Otherwise the primary active output, or the
# first active one (an active output has a position, e.g. "1920x1080+0+0").
out=${XORG_OUTPUT_NAME:-}
if [ -z "$out" ]; then
    out=$(xrandr --query 2>/dev/null | awk '
        ($2 == "connected" || $2 == "disconnected") && /[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/ {
            if (/ primary /) { print $1; found = 1; exit }
            if (first == "") first = $1
        }
        END { if (!found && first != "") print first }')
fi
if [ -z "$out" ]; then
    warn "set-refresh: no active display found"
    exit 0
fi

if xrandr --output "$out" --mode "$mode" 2>/dev/null; then
    log "Screen set to ${want} Hz ($mode on $out)"
else
    warn "Could not switch $out to $mode; keeping the current refresh rate"
fi

fps=${SUNSHINE_CLIENT_FPS:-}
if [ -n "$fps" ] && [ "$fps" != "$want" ]; then
    log "Moonlight is streaming at ${fps} fps. Set Moonlight's frame rate to ${want} for the smoothest picture."
fi
exit 0
