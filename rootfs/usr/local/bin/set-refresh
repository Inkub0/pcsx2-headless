#!/usr/bin/env bash
# Kept for custom Sunshine apps from older versions: "set-refresh 50" or "set-refresh 60" now
# runs set-mode at that refresh rate and the configured resolution. Always exits 0.
case ${1:-60} in
    50|60) ;;
    *) exit 0 ;;
esac
SUNSHINE_CLIENT_FPS=$1 DISPLAY_MATCH=refresh exec /usr/local/bin/set-mode client
