#!/usr/bin/env bash
# Writes /etc/X11/xorg.conf for the detected GPU.
#
#   amd    -> amdgpu driver, TearFree, real output (forced on if nothing is plugged in)
#   intel  -> modesetting driver (glamor), real output (forced on if nothing is plugged in)
#   nvidia -> nvidia driver, fake connected monitor, ForceFullCompositionPipeline
#   dummy  -> software-only virtual screen
set -euo pipefail
# shellcheck source=/usr/local/lib/pcsx2-headless/common.sh
. /usr/local/lib/pcsx2-headless/common.sh
load_runtime_env

res=${RESOLUTION:-1920x1080}
rate=${REFRESH_RATE:-60}
w=${res%x*}
h=${res#*x}
[[ $w =~ ^[0-9]+$ && $h =~ ^[0-9]+$ ]] || die "RESOLUTION must look like 1920x1080 (got '$res')"
[[ $rate =~ ^[0-9]+$ ]] || die "REFRESH_RATE must be a whole number (got '$rate')"
tearfree=false; is_true "${TEARFREE:-true}" && tearfree=true
autoadd=false; is_true "${ENABLE_UDEV:-true}" && autoadd=true

# CVT reduced-blanking modelines for the common 60 Hz modes; cvt(1) for anything else.
case "${w}x${h}@${rate}" in
    1280x720@60)  ML='"1280x720R" 64.00 1280 1328 1360 1440 720 723 728 741 +hsync -vsync' ;;
    1920x1080@60) ML='"1920x1080R" 138.50 1920 1968 2000 2080 1080 1083 1088 1111 +hsync -vsync' ;;
    2560x1440@60) ML='"2560x1440R" 241.50 2560 2608 2640 2720 1440 1443 1448 1481 +hsync -vsync' ;;
    3840x2160@60) ML='"3840x2160R" 533.00 3840 3888 3920 4000 2160 2163 2168 2222 +hsync -vsync' ;;
    *)
        command -v cvt >/dev/null 2>&1 \
            || die "No built-in mode for ${w}x${h}@${rate}. Use 1280x720, 1920x1080, 2560x1440 or 3840x2160 at 60 Hz."
        ML=$(cvt "$w" "$h" "$rate" | sed -n 's/^Modeline //p')
        ;;
esac
MODE=$(awk '{print $1}' <<<"$ML" | tr -d '"')

# Kernel connector name (e.g. DP-1, HDMI-A-1) -> name used by the Xorg driver.
xorg_output_name() {
    local driver=$1 kname=$2 type idx
    type=${kname%-*}
    idx=${kname##*-}
    case $driver in
        amdgpu)
            case $type in
                DP) echo "DisplayPort-$((idx - 1))" ;;
                eDP) echo "eDP" ;;
                *) echo "$type-$((idx - 1))" ;;
            esac ;;
        modesetting)
            case $type in
                HDMI-A) echo "HDMI-$idx" ;;
                *) echo "$kname" ;;
            esac ;;
    esac
}

# Prints "<kernel connector> <connected|forced>", preferring a connected output.
pick_connector() {
    local card=$1 con kname first=""
    for con in /sys/class/drm/"$card"-*; do
        [ -r "$con/status" ] || continue
        kname=${con##*/"$card"-}
        case $kname in Writeback-*) continue ;; esac
        [ -z "$first" ] && first=$kname
        if [ "$(cat "$con/status")" = connected ]; then
            echo "$kname connected"
            return 0
        fi
    done
    [ -n "$first" ] && echo "$first forced"
}

busid_for_card() {
    local card=$1
    [ -n "$card" ] && [ -e "/sys/class/drm/$card/device" ] || return 1
    pci_to_busid "$(readlink -f "/sys/class/drm/$card/device")"
}

out=/etc/X11/xorg.conf
{
cat <<EOF
# Generated by PCSX2 Headless at container start ($(date -u +%FT%TZ)).
# GPU: ${GPU_TYPE}  Mode: ${MODE}  TearFree: ${tearfree}
# Changes here are overwritten on every start; use environment variables instead.

Section "ServerFlags"
    Option "DontVTSwitch" "true"
    Option "AllowMouseOpenFail" "true"
    Option "AutoAddDevices" "${autoadd}"
    Option "AutoAddGPU" "false"
    Option "BlankTime" "0"
    Option "StandbyTime" "0"
    Option "SuspendTime" "0"
    Option "OffTime" "0"
EndSection

Section "ServerLayout"
    Identifier "layout"
    Screen 0 "screen0"
EndSection

EOF

case $GPU_TYPE in
    amd|intel)
        driver=amdgpu; [ "$GPU_TYPE" = intel ] && driver=modesetting
        busid=$(busid_for_card "$DRI_CARD") || die "Could not find the PCI address of $DRI_CARD"
        if [ -n "${XORG_OUTPUT:-}" ]; then
            output=$XORG_OUTPUT; how=user
        else
            read -r kname how <<<"$(pick_connector "$DRI_CARD")" || true
            [ -n "${kname:-}" ] || die "$DRI_CARD has no display outputs. Set GPU_TYPE=dummy, or use a GPU with outputs."
            output=$(xorg_output_name "$driver" "$kname")
        fi
        if [ "$how" = forced ]; then
            warn "Nothing is plugged into the GPU: forcing output $output on at $MODE."
            warn "If the stream stays black, plug an HDMI/DisplayPort dummy adapter into the GPU."
        else
            log "Display output: $output ($how)"
        fi
        cat <<EOF
Section "Device"
    Identifier "gpu0"
    Driver "${driver}"
    BusID "${busid}"
    Option "TearFree" "${tearfree}"
EOF
        [ "$GPU_TYPE" = intel ] && echo '    Option "AccelMethod" "glamor"'
        cat <<EOF
    Option "Monitor-${output}" "monitor0"
EndSection

Section "Monitor"
    Identifier "monitor0"
    Modeline ${ML}
    Option "PreferredMode" "${MODE}"
    Option "Enable" "true"
EndSection

Section "Screen"
    Identifier "screen0"
    Device "gpu0"
    Monitor "monitor0"
    DefaultDepth 24
    SubSection "Display"
        Depth 24
        Modes "${MODE}"
        Virtual ${w} ${h}
    EndSubSection
EndSection
EOF
        ;;
    nvidia)
        busid=""
        if command -v nvidia-smi >/dev/null 2>&1; then
            raw=$(nvidia-smi --query-gpu=pci.bus_id --format=csv,noheader 2>/dev/null | head -n1 || true)
            [ -n "$raw" ] && busid=$(pci_to_busid "$raw")
        fi
        [ -n "$busid" ] || busid=$(busid_for_card "${DRI_CARD:-}") || die "Could not find the NVIDIA GPU's PCI address"
        ffcp=Off; [ "$tearfree" = true ] && ffcp=On
        cat <<EOF
Section "Device"
    Identifier "gpu0"
    Driver "nvidia"
    BusID "${busid}"
    Option "AllowEmptyInitialConfiguration" "true"
    Option "ConnectedMonitor" "${NVIDIA_CONNECTED_MONITOR:-DFP-0}"
    Option "ModeValidation" "NoMaxPClkCheck, NoEdidMaxPClkCheck, NoMaxSizeCheck, NoHorizSyncCheck, NoVertRefreshCheck, NoVirtualSizeCheck, NoTotalSizeCheck, NoDualLinkDVICheck, NoDisplayPortBandwidthCheck, AllowNonEdidModes, NoEdidModes"
    Option "HardDPMS" "false"
EndSection

Section "Monitor"
    Identifier "monitor0"
    HorizSync 5.0 - 1000.0
    VertRefresh 5.0 - 1000.0
    Modeline ${ML}
EndSection

Section "Screen"
    Identifier "screen0"
    Device "gpu0"
    Monitor "monitor0"
    DefaultDepth 24
    Option "MetaModes" "${NVIDIA_CONNECTED_MONITOR:-DFP-0}: ${MODE} +0+0 { ForceFullCompositionPipeline = ${ffcp} }"
    SubSection "Display"
        Depth 24
        Modes "${MODE}"
        Virtual ${w} ${h}
    EndSubSection
EndSection
EOF
        ;;
    dummy)
        cat <<EOF
Section "Device"
    Identifier "gpu0"
    Driver "dummy"
    VideoRam 256000
EndSection

Section "Monitor"
    Identifier "monitor0"
    HorizSync 5.0 - 1000.0
    VertRefresh 5.0 - 200.0
    Modeline ${ML}
EndSection

Section "Screen"
    Identifier "screen0"
    Device "gpu0"
    Monitor "monitor0"
    DefaultDepth 24
    SubSection "Display"
        Depth 24
        Modes "${MODE}"
        Virtual ${w} ${h}
    EndSubSection
EndSection
EOF
        ;;
esac
} > "$out"

log "Wrote $out (${GPU_TYPE}, ${MODE})"
