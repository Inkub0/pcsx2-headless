#!/usr/bin/env bash
# Writes first-run settings for PCSX2 and Sunshine, running as the pcsx2 user.
# Settings you change later in PCSX2 or the Sunshine web UI are kept, except for the
# few keys below that must always match the container (paths, capture, encoder).
set -euo pipefail
# shellcheck source=/usr/local/lib/pcsx2-headless/common.sh
. /usr/local/lib/pcsx2-headless/common.sh
load_runtime_env

defaults=/usr/local/share/pcsx2-headless

# -------------------------------------------------------------- PCSX2 ----
ini=$XDG_CONFIG_HOME/PCSX2/inis/PCSX2.ini
mkdir -p "${ini%/*}"
if [ ! -s "$ini" ]; then
    log "First run: writing default PCSX2 settings"
    cp "$defaults/PCSX2.ini" "$ini"
fi
set_ini() { crudini --set "$ini" "$1" "$2" "$3"; }
set_ini Folders Bios /bios
set_ini UI SetupWizardIncomplete false
set_ini AutoUpdater CheckAtStartup false
# Frame timing for a smooth stream: standard NTSC (59.94) and PAL (50) rates, and let PCSX2 adjust
# its speed very slightly to the screen's refresh (59.93 Hz, or 49.99 Hz in the PAL entry), so each
# game frame matches exactly one screen refresh. Needs VSync, which is on by default.
set_ini EmuCore/GS FrameRateNTSC 59.94
set_ini EmuCore/GS FrameRatePAL 50
set_ini EmuCore/GS SyncToHostRefreshRate true
[ -n "${PCSX2_RENDERER:-}" ] && set_ini EmuCore/GS Renderer "$PCSX2_RENDERER"
[ -n "${PCSX2_UPSCALE:-}" ] && set_ini EmuCore/GS upscale_multiplier "$PCSX2_UPSCALE"

# ----------------------------------------------------------- Sunshine ----
sdir=$XDG_CONFIG_HOME/sunshine
conf=$sdir/sunshine.conf
mkdir -p "$sdir"
if [ ! -s "$conf" ]; then
    log "First run: writing default Sunshine settings"
    cp "$defaults/sunshine.conf" "$conf"
fi
apps=$sdir/apps.json
[ -s "$apps" ] || cp "$defaults/apps.json" "$apps"
# The PCSX2 entries are managed by the image: refresh them from the defaults on every start,
# keeping a picture the user has set (not one of ours), and drop the old "Restart PCSX2" entry.
# Entries the user added are kept as they are.
if updated=$(jq --slurpfile d "$defaults/apps.json" '
        ($d[0].apps | map(.name)) as $managed
        | (.apps // []) as $cur
        | .apps = ($d[0].apps
                   | map(. as $a
                         | (first($cur[] | select(.name == $a.name) | ."image-path") // "") as $img
                         | if $img != "" and ($img | startswith("/usr/local/share/pcsx2-headless/") | not)
                           then ."image-path" = $img else . end))
                  + [$cur[] | select(.name as $n | ($managed + ["Restart PCSX2"]) | index($n) | not)]
    ' "$apps" 2>/dev/null); then
    printf '%s\n' "$updated" > "$apps"
else
    warn "Could not update $apps (is it valid JSON?); leaving it unchanged"
fi

set_conf() {
    local key=$1 value=$2
    if grep -qE "^[[:space:]]*${key}[[:space:]]*=" "$conf"; then
        sed -i -E "s|^[[:space:]]*${key}[[:space:]]*=.*|${key} = ${value}|" "$conf"
    else
        echo "${key} = ${value}" >> "$conf"
    fi
}
set_conf sunshine_name "${SUNSHINE_NAME:-pcsx2-headless}"
set_conf file_apps "$sdir/apps.json"
# kms (default) reads the finished frame from the GPU (needs CAP_SYS_ADMIN, which the sunshine
# binary has); x11 copies the screen without waiting for the display refresh and can show tearing.
capture=${SUNSHINE_CAPTURE:-kms}
case $capture in
    x11|kms) ;;
    *) warn "SUNSHINE_CAPTURE must be x11 or kms (got '$capture'); using kms"; capture=kms ;;
esac
set_conf capture "$capture"

encoder=${SUNSHINE_ENCODER:-}
if [ -z "$encoder" ]; then
    case $GPU_TYPE in
        amd|intel) encoder=vaapi ;;
        nvidia) encoder=nvenc ;;
        *) encoder=software ;;
    esac
fi
set_conf encoder "$encoder"
if [ "$encoder" = vaapi ] && [ -n "${DRI_RENDER:-}" ]; then
    set_conf adapter_name "$DRI_RENDER"
fi

# Sunshine's CSRF protection only accepts web UI changes (e.g. the pairing PIN) from localhost.
# Allow this server's own IPv4 addresses on the web UI port, plus SUNSHINE_ALLOWED_ORIGINS
# (comma-separated, e.g. https://truenas.local:47990). With host networking these are the
# host's addresses.
origins=""
for ip in $(awk '/32 host LOCAL/ {print prev} {prev=$2}' /proc/net/fib_trie 2>/dev/null | sort -u); do
    case $ip in 127.*) continue ;; esac
    origins="${origins:+$origins,}https://$ip:47990"
done
if [ -n "${SUNSHINE_ALLOWED_ORIGINS:-}" ]; then
    origins="${origins:+$origins,}${SUNSHINE_ALLOWED_ORIGINS// /}"
fi
if [ -n "$origins" ]; then
    set_conf csrf_allowed_origins "$origins"
    log "Sunshine web UI accepts changes from: $origins"
fi

# Who may open the web UI: lan = private addresses (10.*, 172.16-31.*, 192.168.*), wan = any
# address (e.g. VPN or public IPv6), pc = this server only. Moonlight streaming is not affected.
webui=${SUNSHINE_WEBUI_ACCESS:-lan}
case $webui in
    lan|wan|pc) ;;
    *) warn "SUNSHINE_WEBUI_ACCESS must be lan, wan or pc (got '$webui'); using lan"; webui=lan ;;
esac
set_conf origin_web_ui_allowed "$webui"
