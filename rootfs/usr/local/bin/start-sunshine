#!/usr/bin/env bash
set -euo pipefail
. /usr/local/lib/pcsx2-headless/common.sh

wait_for_x 60 || die "X server did not start; see /tmp/Xorg.0.log"
wait_for_file "$PULSE_SOCKET" 30 || warn "Audio server not ready: the stream may have no sound"
exec_as_user sunshine /config/.config/sunshine/sunshine.conf
